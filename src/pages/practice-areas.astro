---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PracticeAreas from "../components/sections/PracticeAreas.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import { sitePracticeAreas, siteTestimonialReviews } from "../data/site";

import practiceAreasHeroBg from "../assets/images/practice-areas-hero-bg.png";
---

<Layout title="Practice Areas | Pinyerd Disability Law, LLC">
  <PageHero
    title="Our Practice Areas"
    backgroundImage={practiceAreasHeroBg}
    backgroundAlt="Indianapolis skyline at dusk"
  />

  <PracticeAreas
    eyebrow="Schedule an Initial Consultation Today!"
    title="When the Path Forward is Unclear, We'll Be Your Guide"
    description={`Unlike some of the larger firms or national companies where you mostly work with a "case manager," with us you work directly with an attorney. Contact us now for a confidential, no obligation case review.`}
    areas={sitePracticeAreas}
  />

  <Testimonials
    eyebrow="What They Say"
    title="Words From Our Clients"
    description="Testimonials from our clients from around the web."
    ctaLabel="See All Reviews"
    ctaHref="/testimonials"
    reviews={siteTestimonialReviews}
  />
</Layout>
