---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  quote: string;
  name: string;
  avatar: ImageMetadata;
}

const { quote, name, avatar } = Astro.props;
---

<article class="testimonial-card">
  <p class="testimonial-card-quote">&ldquo;{quote}&rdquo;</p>

  <div class="testimonial-card-footer">
    <div class="testimonial-card-divider"></div>
    <div class="testimonial-card-meta">
      <div class="testimonial-card-person">
        <div class="testimonial-card-avatar">
          <Image src={avatar} alt={name} width={48} height={48} fit="cover" />
        </div>
        <p class="testimonial-card-name">{name}</p>
      </div>
      <img src="/icons/icon-stars-5.svg" alt="5 out of 5 stars" class="testimonial-card-stars" />
    </div>
  </div>
</article>

<style>
  .testimonial-card {
    display: flex;
    height: 350px;
    width: 100%;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    box-shadow: 0 27px 40px rgba(0, 0, 0, 0.03), 0 6px 7.5px rgba(0, 0, 0, 0.03);
    padding: 40px 32px;
  }

  .testimonial-card-quote {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .testimonial-card-footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .testimonial-card-divider {
    height: 1px;
    width: 100%;
    background: #ededed;
  }

  .testimonial-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .testimonial-card-person {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-card-avatar {
    height: 48px;
    width: 48px;
    overflow: hidden;
    border-radius: 999px;
    border: 2px solid var(--color-white);
    box-shadow: 0 0 0 2px var(--color-maroon);
  }

  .testimonial-card-avatar :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .testimonial-card-name {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink);
  }

  .testimonial-card-stars {
    height: 16px;
    width: 86px;
  }

  @media (min-width: 640px) {
    .testimonial-card {
      width: 393px;
    }
  }
</style>
