---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  backgroundImage: ImageMetadata;
  heading: string;
  phoneDisplay: string;
  phoneHref: string;
  servingLabel: string;
  mapLabel: string;
  mapHref: string;
  description: string;
  formHeading: string;
  reasonsLabel: string;
  reasons: string[];
  messageLabel: string;
  submitLabel: string;
  formAction: string;
}

const {
  backgroundImage,
  heading,
  phoneDisplay,
  phoneHref,
  servingLabel,
  mapLabel,
  mapHref,
  description,
  formHeading,
  reasonsLabel,
  reasons,
  messageLabel,
  submitLabel,
  formAction,
} = Astro.props;
---

<section class="relative flex flex-col items-center justify-center overflow-hidden px-6 py-16 lg:py-[88px]">
  <div class="absolute inset-0 -z-10">
    <Image src={backgroundImage} alt="" aria-hidden="true" class="h-full w-full object-cover" width={1920} height={1022} fit="cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-[#6c8dbb] via-[#c9d8e9] via-55% to-[#f8d7d4]"></div>
  </div>

  <div class="content relative flex flex-col gap-12 rounded-xl border border-white/35 bg-gradient-to-b from-[rgba(31,31,31,0.27)] to-[rgba(31,31,31,0.9)] p-8 shadow-[0_9px_16px_0_rgba(0,0,0,0.37)] backdrop-blur-sm lg:flex-row lg:gap-0 lg:p-20">
    <div class="flex w-full flex-col gap-4 lg:w-[400px] lg:shrink-0">
      <h2 class="font-serif text-3xl leading-tight text-white lg:text-[35px]">{heading}</h2>
      <p class="font-serif text-xl text-white lg:text-2xl">
        CALL <a href={phoneHref} class="hover:underline">{phoneDisplay}</a>
      </p>
      <p class="font-sans text-base font-semibold text-white">{servingLabel}</p>
      <a href={mapHref} class="font-sans text-base font-semibold text-white underline">{mapLabel}</a>
      <p class="font-sans text-base leading-relaxed text-white" set:html={description} />
    </div>

    <form class="flex w-full flex-col gap-10 lg:pl-16" method="post" action={formAction}>
      <h3 class="font-serif text-3xl leading-tight text-white lg:text-[35px] lg:max-w-[537px]">{formHeading}</h3>

      <div class="flex flex-col gap-7">
        <label class="flex flex-col gap-2">
          <span class="sr-only">Enter Your Name</span>
          <input
            type="text"
            name="name"
            required
            placeholder="Enter Your Name"
            class="w-full border-b border-white bg-transparent pb-3 font-sans text-base text-white placeholder:text-white/80 focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-2">
          <span class="sr-only">Enter Your Email Address</span>
          <input
            type="email"
            name="email"
            required
            placeholder="Enter Your Email Address"
            class="w-full border-b border-white bg-transparent pb-3 font-sans text-base text-white placeholder:text-white/80 focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-2">
          <span class="sr-only">Enter Your Phone Number</span>
          <input
            type="tel"
            name="phone"
            required
            placeholder="Enter Your Phone Number"
            class="w-full border-b border-white bg-transparent pb-3 font-sans text-base text-white placeholder:text-white/80 focus:outline-none"
          />
        </label>

        <fieldset class="flex flex-col gap-4">
          <legend class="mb-1 font-sans text-base text-white">{reasonsLabel}</legend>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {reasons.map((reason) => (
              <label class="flex items-center gap-3 font-sans text-sm text-white">
                <input type="checkbox" name="reason" value={reason} class="h-[22px] w-[22px] rounded-sm border-[1.3px] border-[#d0d0d0] bg-transparent" />
                {reason}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="flex flex-col gap-2">
          <span class="sr-only">{messageLabel}</span>
          <textarea
            name="message"
            rows="2"
            placeholder={messageLabel}
            class="w-full resize-none border-b border-white bg-transparent pb-3 font-sans text-base text-white placeholder:text-white/80 focus:outline-none"
          ></textarea>
        </label>
      </div>

      <button
        type="submit"
        class="w-full max-w-[537px] rounded-xl bg-white py-3 font-sans text-base font-medium text-ink"
      >
        {submitLabel}
      </button>
    </form>
  </div>
</section>
