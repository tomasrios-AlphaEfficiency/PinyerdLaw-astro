---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  backgroundImage: ImageMetadata;
  heading: string;
  phoneDisplay: string;
  phoneHref: string;
  servingLabel: string;
  mapLabel: string;
  mapHref: string;
  description: string;
  formHeading: string;
  reasonsLabel: string;
  reasons: string[];
  messageLabel: string;
  submitLabel: string;
  formAction: string;
}

const {
  backgroundImage,
  heading,
  phoneDisplay,
  phoneHref,
  servingLabel,
  mapLabel,
  mapHref,
  description,
  formHeading,
  reasonsLabel,
  reasons,
  messageLabel,
  submitLabel,
  formAction,
} = Astro.props;
---

<section class="contact-form">
  <div class="contact-form-background">
    <Image src={backgroundImage} alt="" aria-hidden="true" width={1920} height={1022} fit="cover" />
    <div class="contact-form-background-tint"></div>
  </div>

  <div class="content contact-form-panel">
    <div class="contact-form-info">
      <h2 class="contact-form-heading">{heading}</h2>
      <p class="contact-form-phone">
        CALL <a href={phoneHref} class="contact-form-phone-link">{phoneDisplay}</a>
      </p>
      <p class="contact-form-serving">{servingLabel}</p>
      <a href={mapHref} class="contact-form-map-link">{mapLabel}</a>
      <p class="contact-form-description" set:html={description} />
    </div>

    <form class="contact-form-fields" method="post" action={formAction}>
      <h3 class="contact-form-fields-heading">{formHeading}</h3>

      <div class="contact-form-inputs">
        <label class="contact-form-field">
          <span class="sr-only">Enter Your Name</span>
          <input type="text" name="name" required placeholder="Enter Your Name" class="contact-form-input" />
        </label>
        <label class="contact-form-field">
          <span class="sr-only">Enter Your Email Address</span>
          <input type="email" name="email" required placeholder="Enter Your Email Address" class="contact-form-input" />
        </label>
        <label class="contact-form-field">
          <span class="sr-only">Enter Your Phone Number</span>
          <input type="tel" name="phone" required placeholder="Enter Your Phone Number" class="contact-form-input" />
        </label>

        <fieldset class="contact-form-reasons">
          <legend class="contact-form-reasons-legend">{reasonsLabel}</legend>
          <div class="contact-form-reasons-grid">
            {reasons.map((reason) => (
              <label class="contact-form-reason">
                <input type="checkbox" name="reason" value={reason} class="contact-form-checkbox" />
                {reason}
              </label>
            ))}
          </div>
        </fieldset>

        <label class="contact-form-field">
          <span class="sr-only">{messageLabel}</span>
          <textarea name="message" rows="2" placeholder={messageLabel} class="contact-form-input contact-form-textarea"></textarea>
        </label>
      </div>

      <button type="submit" class="contact-form-submit">
        {submitLabel}
      </button>
    </form>
  </div>
</section>

<style>
  .contact-form {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 64px var(--gutter);
  }

  .contact-form-background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .contact-form-background :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .contact-form-background-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #6c8dbb 0%, #c9d8e9 55%, #f8d7d4 100%);
  }

  .contact-form-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0.27), rgba(31, 31, 31, 0.9));
    box-shadow: 0 9px 16px 0 rgba(0, 0, 0, 0.37);
    backdrop-filter: blur(4px);
    padding: 32px;
  }

  .contact-form-info {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 16px;
  }

  .contact-form-heading {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.2;
    color: var(--color-white);
  }

  .contact-form-phone {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--color-white);
  }

  .contact-form-phone-link:hover {
    text-decoration: underline;
  }

  .contact-form-serving {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-white);
  }

  .contact-form-map-link {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-white);
    text-decoration: underline;
  }

  .contact-form-description {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.625;
    color: var(--color-white);
  }

  .contact-form-fields {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 40px;
  }

  .contact-form-fields-heading {
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1.2;
    color: var(--color-white);
  }

  .contact-form-inputs {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-form-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--color-white);
    background: transparent;
    padding-bottom: 12px;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--color-white);
  }

  .contact-form-input::placeholder {
    color: rgba(255, 255, 255, 0.8);
  }

  .contact-form-input:focus {
    outline: none;
  }

  .contact-form-textarea {
    resize: none;
  }

  .contact-form-reasons {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border: none;
    padding: 0;
    margin: 0;
  }

  .contact-form-reasons-legend {
    margin-bottom: 4px;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--color-white);
    padding: 0;
  }

  .contact-form-reasons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .contact-form-reason {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-white);
  }

  .contact-form-checkbox {
    height: 22px;
    width: 22px;
    border-radius: 2px;
    border: 1.3px solid #d0d0d0;
    background: transparent;
  }

  .contact-form-submit {
    width: 100%;
    max-width: 537px;
    border: none;
    border-radius: 12px;
    background: var(--color-white);
    padding-block: 12px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .contact-form-reasons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact-form {
      padding-block: 88px;
    }

    .contact-form-panel {
      flex-direction: row;
      gap: 0;
      padding: 80px;
    }

    .contact-form-info {
      width: 400px;
      flex-shrink: 0;
    }

    .contact-form-fields {
      padding-left: 64px;
    }

    .contact-form-fields-heading {
      max-width: 537px;
    }
  }
</style>
