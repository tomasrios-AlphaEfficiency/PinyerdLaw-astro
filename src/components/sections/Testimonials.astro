---
import type { ImageMetadata } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";
import TestimonialCard from "../TestimonialCard.astro";

interface Review {
  quote: string;
  name: string;
  avatar: ImageMetadata;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  reviews: Review[];
}

const { eyebrow, title, description, ctaLabel, ctaHref, reviews } = Astro.props;
---

<section class="flex flex-col items-center gap-8 bg-white px-6 py-16 lg:py-[140px]">
  <div class="content flex flex-col gap-8">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex w-full flex-col items-start gap-5 lg:w-[323px]">
        <SectionHeading eyebrow={eyebrow} title={title}>
          <p class="font-sans text-base tracking-tight text-ink">{description}</p>
        </SectionHeading>
        <Button href={ctaHref} variant="solid">{ctaLabel}</Button>
      </div>

      <div class="flex w-full flex-col gap-5 sm:flex-row sm:justify-center lg:w-auto">
        {reviews.map((review) => (
          <TestimonialCard quote={review.quote} name={review.name} avatar={review.avatar} />
        ))}
      </div>
    </div>

    <div class="flex h-[45px] w-[90px] self-end overflow-hidden rounded-md">
      <button type="button" aria-label="Previous testimonial" class="flex h-full w-1/2 items-center justify-center bg-ink">
        <img src="/icons/icon-carousel-prev.svg" alt="" class="h-6 w-6 rotate-180" aria-hidden="true" />
      </button>
      <button type="button" aria-label="Next testimonial" class="flex h-full w-1/2 items-center justify-center bg-ink">
        <img src="/icons/icon-carousel-prev.svg" alt="" class="h-6 w-6" aria-hidden="true" />
      </button>
    </div>
  </div>
</section>
