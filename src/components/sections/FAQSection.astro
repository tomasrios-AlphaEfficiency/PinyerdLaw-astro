---
import SectionHeading from "../SectionHeading.astro";
import FAQItem from "../FAQItem.astro";

interface FAQ {
  question: string;
  answer: string;
  open?: boolean;
}

interface Props {
  eyebrow: string;
  title: string;
  faqs: FAQ[];
}

const { eyebrow, title, faqs } = Astro.props;
---

<section class="flex flex-col items-center gap-8 bg-surface px-6 py-16 lg:py-[140px]">
  <div class="content flex flex-col gap-8">
    <SectionHeading eyebrow={eyebrow} title={title} />

    <div class="flex flex-col gap-4">
      {faqs.map((faq) => (
        <FAQItem question={faq.question} answer={faq.answer} open={faq.open} />
      ))}
    </div>
  </div>
</section>
