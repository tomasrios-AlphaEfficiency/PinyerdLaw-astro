---
import { Image, type ImageMetadata } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  eyebrow: string;
  title: string;
  name: string;
  bio: string;
  href: string;
  ctaLabel: string;
  variant: "dark" | "light";
  image: ImageMetadata;
}

const { eyebrow, title, name, bio, href, ctaLabel, variant, image } = Astro.props;
const isDark = variant === "dark";
---

<section class="feature-banner">
  <div class="content feature-banner-inner">
    <SectionHeading eyebrow={eyebrow} title={title} />

    {isDark ? (
      <div class="feature-banner-card feature-banner-card--dark">
        <div class="feature-banner-card-image">
          <Image src={image} alt={name} width={569} height={434} fit="cover" />
        </div>
        <div class="feature-banner-card-tint"></div>

        <div class="feature-banner-card-text feature-banner-card-text--dark">
          <h3 class="feature-banner-name feature-banner-name--dark">{name}</h3>
          <div class="feature-banner-rule feature-banner-rule--dark"></div>
          <p class="feature-banner-bio feature-banner-bio--dark">{bio}</p>
          <a href={href} class="feature-banner-cta feature-banner-cta--dark">
            {ctaLabel}
          </a>
        </div>
      </div>
    ) : (
      <div class="feature-banner-card feature-banner-card--light">
        <div class="feature-banner-card-image feature-banner-card-image--light">
          <Image src={image} alt={name} width={519} height={434} fit="cover" />
        </div>
        <div class="feature-banner-card-text feature-banner-card-text--light">
          <h3 class="feature-banner-name feature-banner-name--light">{name}</h3>
          <div class="feature-banner-rule feature-banner-rule--light"></div>
          <p class="feature-banner-bio feature-banner-bio--light">{bio}</p>
          <a href={href} class="feature-banner-cta feature-banner-cta--light">
            {ctaLabel}
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .feature-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    padding: 64px var(--gutter);
  }

  .feature-banner-inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .feature-banner-card {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    box-shadow: -6px -6px 27.6px 0 rgba(111, 145, 200, 0.15), 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }

  .feature-banner-card--dark {
    display: flex;
    height: 320px;
    align-items: center;
    justify-content: flex-end;
    background: #37373b;
  }

  .feature-banner-card--light {
    display: flex;
    height: auto;
    flex-direction: column;
  }

  .feature-banner-card-image {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 100%;
  }

  .feature-banner-card-image :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .feature-banner-card-image--light {
    position: relative;
    inset: auto;
    height: 220px;
    width: 100%;
    flex-shrink: 0;
    background: #333437;
  }

  .feature-banner-card-image--light :global(img) {
    position: absolute;
    inset: 0;
  }

  .feature-banner-card-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(55, 55, 59, 0.8) 40%,
      #37373b 60%
    );
  }

  .feature-banner-card-text {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .feature-banner-card-text--dark {
    width: 100%;
    max-width: 584px;
    padding: 0 32px;
  }

  .feature-banner-card-text--light {
    flex: 1;
    justify-content: center;
    background: var(--color-white);
    padding: 40px 32px;
  }

  .feature-banner-name {
    font-family: var(--font-serif);
    font-size: 30px;
    letter-spacing: -0.01em;
  }

  .feature-banner-name--dark {
    color: var(--color-white);
  }

  .feature-banner-name--light {
    color: var(--color-navy-light);
  }

  .feature-banner-rule {
    height: 1px;
    width: 65px;
  }

  .feature-banner-rule--dark {
    background: var(--color-white);
  }

  .feature-banner-rule--light {
    background: var(--color-navy-light);
  }

  .feature-banner-bio {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.625;
    letter-spacing: -0.01em;
  }

  .feature-banner-bio--dark {
    color: var(--color-white);
  }

  .feature-banner-bio--light {
    color: var(--color-navy-light);
  }

  .feature-banner-cta {
    border-radius: 12px;
    padding: 12px 32px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
  }

  .feature-banner-cta--dark {
    background: var(--color-white);
    color: var(--color-navy);
  }

  .feature-banner-cta--light {
    background: var(--color-maroon);
    color: var(--color-white);
    padding-block: 16px;
  }

  @media (min-width: 1024px) {
    .feature-banner {
      padding-block: 100px;
    }

    .feature-banner-inner {
      gap: 70px;
    }

    .feature-banner-card--dark {
      height: 434px;
    }

    .feature-banner-card--light {
      height: 434px;
      flex-direction: row;
    }

    .feature-banner-card-image {
      width: 47%;
    }

    .feature-banner-card-image--light {
      height: 100%;
      width: 519px;
    }

    .feature-banner-card-text--dark {
      padding: 0 64px;
    }

    .feature-banner-card-text--light {
      padding: 40px 82px;
    }

    .feature-banner-name {
      font-size: 40px;
    }
  }
</style>
