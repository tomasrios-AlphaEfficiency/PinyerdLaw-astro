---
import type { ImageMetadata } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";
import BlogCard from "../BlogCard.astro";

interface Post {
  image: ImageMetadata;
  date: string;
  category: string;
  title: string;
  excerpt: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  posts: Post[];
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow, title, posts, ctaLabel, ctaHref } = Astro.props;
---

<section class="flex flex-col items-start bg-white px-6 py-16 lg:py-[140px]">
  <div class="content flex flex-col gap-8">
    <SectionHeading eyebrow={eyebrow} title={title} />

    <div class="flex flex-col gap-5 lg:flex-row">
      {posts.map((post) => (
        <BlogCard
          image={post.image}
          date={post.date}
          category={post.category}
          title={post.title}
          excerpt={post.excerpt}
          href={post.href}
        />
      ))}
    </div>

    <Button href={ctaHref} variant="solid">{ctaLabel}</Button>
  </div>
</section>
