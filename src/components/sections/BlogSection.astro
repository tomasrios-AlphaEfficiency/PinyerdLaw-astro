---
import type { ImageMetadata } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";
import BlogCard from "../BlogCard.astro";

interface Post {
  image: ImageMetadata;
  date: string;
  category: string;
  title: string;
  excerpt: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  posts: Post[];
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow, title, posts, ctaLabel, ctaHref } = Astro.props;
---

<section class="blog-section">
  <div class="content blog-section-inner">
    <SectionHeading eyebrow={eyebrow} title={title} />

    <div class="blog-section-list">
      {posts.map((post) => (
        <BlogCard
          image={post.image}
          date={post.date}
          category={post.category}
          title={post.title}
          excerpt={post.excerpt}
          href={post.href}
        />
      ))}
    </div>

    <Button href={ctaHref} variant="solid">{ctaLabel}</Button>
  </div>
</section>

<style>
  .blog-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--color-white);
    padding: 64px var(--gutter);
  }

  .blog-section-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .blog-section-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .blog-section {
      padding-block: 140px;
    }

    .blog-section-list {
      flex-direction: row;
    }
  }
</style>
