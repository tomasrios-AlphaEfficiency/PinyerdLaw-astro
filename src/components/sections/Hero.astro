---
import { getImage, type ImageMetadata } from "astro:assets";
import Button from "../Button.astro";
import HeroBadge from "../HeroBadge.astro";

interface Badge {
  src: ImageMetadata | string;
  alt: string;
  variant?: "image" | "medal";
}

interface Props {
  backgroundImage: ImageMetadata;
  backgroundAlt: string;
  ratingValue: string;
  ratingLabel: string;
  headline: string;
  subheadline: string;
  ctaLabel: string;
  ctaHref: string;
  trustLabel: string;
  secondaryLabel: string;
  badges: Badge[];
}

const {
  backgroundImage,
  backgroundAlt,
  ratingValue,
  ratingLabel,
  headline,
  subheadline,
  ctaLabel,
  ctaHref,
  trustLabel,
  secondaryLabel,
  badges,
} = Astro.props;

const optimizedBackground = await getImage({ src: backgroundImage, width: 1920, format: "webp" });
const heroGradients = `radial-gradient(24.65% 27.65% at 50% 60.55%, rgba(0, 0, 0, 0.84) 0%, rgba(0, 0, 0, 0.00) 100%), linear-gradient(359deg, #060606 28.63%, rgba(6, 6, 6, 0.00) 75.35%), linear-gradient(0deg, rgba(0, 0, 0, 0.10) 0%, rgba(0, 0, 0, 0.10) 100%)`;

// Mobile stacks the trust badges as two fixed rows (4 + 3) with the medal centered below;
// desktop flattens everything back into a single row (see `.hero-badges-row { display: contents }`).
const medalBadge = badges.find((badge) => badge.variant === "medal");
const standardBadges = badges.filter((badge) => badge.variant !== "medal");
const badgeRowOne = standardBadges.slice(0, 4);
const badgeRowTwo = standardBadges.slice(4);
---

<section class="hero">
  <div
    class="hero-background"
    style={`--hero-gradients: ${heroGradients}; --hero-image: url(${optimizedBackground.src});`}
    role="img"
    aria-label={backgroundAlt}
  ></div>

  <div class="content hero-content">
    <div class="hero-rating">
      <div class="hero-rating-score">
        <span class="hero-rating-value">{ratingValue}</span>
        <img src="/icons/icon-star.svg" alt="" class="hero-rating-star" aria-hidden="true" />
        <img src="/icons/logo-google.svg" alt="Google" class="hero-rating-google" />
      </div>
      <div class="hero-rating-divider"></div>
      <p class="hero-rating-label">{ratingLabel}</p>
    </div>

    <div class="hero-headline">
      <h1 class="hero-title">{headline}</h1>
      <p class="hero-subtitle">{subheadline}</p>

      <div class="hero-cta">
        <Button href={ctaHref} variant="solid" icon="phone">{ctaLabel}</Button>

        <div class="hero-trust-row">
          <div class="hero-trust-item">
            <img src="/icons/icon-shield.svg" alt="" class="hero-trust-icon" aria-hidden="true" />
            <span class="hero-trust-label">{trustLabel}</span>
          </div>
          <div class="hero-trust-item">
            <img src="/icons/icon-stars-row.svg" alt="" class="hero-stars-row" aria-hidden="true" />
            <img src="/icons/flag-spain.svg" alt={secondaryLabel} class="hero-flag" />
          </div>
        </div>
      </div>
    </div>

    <div class="hero-badges">
      <div class="hero-badges-rows">
        <div class="hero-badges-row">
          {badgeRowOne.map((badge) => <HeroBadge badge={badge} />)}
        </div>
        <div class="hero-badges-row">
          {badgeRowTwo.map((badge) => <HeroBadge badge={badge} />)}
        </div>
      </div>
      {medalBadge && <HeroBadge badge={medalBadge} />}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background-image: var(--hero-gradients), var(--hero-image);
    background-repeat: no-repeat;
    /* 3 gradient layers (fill the box) + the photo (zoomed/panned to keep the group centered on narrow screens) */
    background-position: 0 0, 0 0, 0 0, 50% top;
    background-size: auto, auto, auto, 259% auto;
    background-color: #fff;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    padding: 96px var(--gutter) 64px;
  }

  .hero-rating {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(0, 0, 0, 0.2);
    padding: 4px 8px;
    backdrop-filter: blur(24px);
  }

  .hero-rating-score {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 4px;
  }

  .hero-rating-value {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-white);
  }

  .hero-rating-star {
    height: 10px;
    width: 10px;
  }

  .hero-rating-google {
    height: 8px;
    width: 35px;
  }

  .hero-rating-divider {
    height: 14px;
    width: 1px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.25);
  }

  .hero-rating-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .hero-headline {
    display: flex;
    width: 100%;
    max-width: 900px;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    text-align: left;
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.6));
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 32px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--color-white);
  }

  .hero-cta {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .hero-trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
  }

  .hero-trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hero-trust-icon {
    height: 16px;
    width: 16px;
  }

  .hero-trust-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .hero-stars-row {
    height: 16px;
    width: 21px;
  }

  .hero-flag {
    height: 10px;
    width: 14px;
  }

  .hero-badges {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    backdrop-filter: blur(12px);
  }

  .hero-badges-rows {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 48px;
    }

    .hero-subtitle {
      font-size: 20px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: 1000px;
      justify-content: center;
    }

    .hero-background {
      background-position: 0 0, 0 0, 0 0, center top;
      background-size: auto, auto, auto, cover;
    }

    .hero-content {
      position: relative;
      align-items: center;
      justify-content: center;
      gap: 32px;
      padding: 96px var(--gutter) 40px;
    }

    .hero-rating {
      position: absolute;
      left: 50%;
      top: 24px;
      transform: translateX(-50%);
      padding: 6px 12px;
    }

    .hero-rating-score {
      gap: 6px;
    }

    .hero-rating-value {
      font-size: 16px;
    }

    .hero-rating-star {
      height: 14px;
      width: 14px;
    }

    .hero-rating-google {
      height: 12px;
      width: 50px;
    }

    .hero-rating-divider {
      height: 16px;
    }

    .hero-rating-label {
      font-size: 14px;
    }

    .hero-headline {
      align-items: center;
      text-align: center;
    }

    .hero-title {
      font-size: 57px;
      letter-spacing: -0.01em;
    }

    .hero-cta {
      align-items: center;
    }

    .hero-trust-row {
      justify-content: center;
    }

    .hero-badges {
      flex-direction: row;
      width: auto;
      align-items: center;
      justify-content: center;
      gap: 22px;
    }

    .hero-badges-rows,
    .hero-badges-row {
      display: contents;
    }
  }
</style>
