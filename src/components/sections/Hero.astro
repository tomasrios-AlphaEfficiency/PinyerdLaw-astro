---
import { Image, type ImageMetadata } from "astro:assets";
import Button from "../Button.astro";
import BBBAccreditedBadge from "../BBBAccreditedBadge.astro";

interface Badge {
  src: ImageMetadata | string;
  alt: string;
  variant?: "image" | "medal";
}

interface Props {
  backgroundImage: ImageMetadata;
  backgroundAlt: string;
  ratingValue: string;
  ratingLabel: string;
  headline: string;
  subheadline: string;
  ctaLabel: string;
  ctaHref: string;
  trustLabel: string;
  secondaryLabel: string;
  badges: Badge[];
}

const {
  backgroundImage,
  backgroundAlt,
  ratingValue,
  ratingLabel,
  headline,
  subheadline,
  ctaLabel,
  ctaHref,
  trustLabel,
  secondaryLabel,
  badges,
} = Astro.props;
---

<section class="relative flex h-[560px] w-full flex-col items-center justify-center overflow-hidden pt-[68px] sm:h-[720px] lg:h-[1000px]">
  <div class="absolute inset-0">
    <Image
      src={backgroundImage}
      alt={backgroundAlt}
      class="h-full w-full scale-110 object-cover object-top"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      priority
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-black/10"></div>
  </div>

  <div class="content relative z-10 flex flex-1 flex-col items-center justify-center gap-8 px-6 pb-10 pt-24">
    <div
      class="absolute left-1/2 top-6 flex -translate-x-1/2 items-center gap-3 rounded-full border border-white/50 bg-black/20 px-3 py-1.5 backdrop-blur-xl"
    >
      <div class="flex items-center gap-1.5">
        <span class="font-sans text-base font-medium text-white">{ratingValue}</span>
        <img src="/icons/icon-star.svg" alt="" class="h-3.5 w-3.5" aria-hidden="true" />
        <img src="/icons/logo-google.svg" alt="Google" class="h-3 w-[50px]" />
      </div>
      <div class="h-4 w-px bg-white/25"></div>
      <p class="whitespace-nowrap font-sans text-sm font-medium uppercase text-white">{ratingLabel}</p>
    </div>

    <div class="flex w-full max-w-[900px] flex-col items-center gap-6 text-center drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
      <h1 class="font-serif text-4xl leading-[1.3] tracking-tight text-white sm:text-5xl lg:text-[57px]">
        {headline}
      </h1>
      <p class="font-sans text-lg text-white sm:text-xl">{subheadline}</p>

      <div class="flex flex-col items-center gap-3">
        <Button href={ctaHref} variant="solid" icon="phone">{ctaLabel}</Button>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <div class="flex items-center gap-1.5">
            <img src="/icons/icon-shield.svg" alt="" class="h-4 w-4" aria-hidden="true" />
            <span class="font-sans text-xs font-medium uppercase tracking-tight text-white">{trustLabel}</span>
          </div>
          <div class="flex items-center gap-1">
            <img src="/icons/icon-stars-row.svg" alt="" class="h-4 w-[21px]" aria-hidden="true" />
            <img src="/icons/flag-spain.svg" alt={secondaryLabel} class="h-2.5 w-3.5" />
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6 backdrop-blur-md">
      {badges.map((badge) => {
        if (badge.src === "bbb") {
          return <BBBAccreditedBadge class="h-10 w-auto opacity-90 sm:h-12" />;
        }
        if (badge.variant === "medal") {
          return typeof badge.src === "string" ? (
            <img src={badge.src} alt={badge.alt} class="h-14 w-auto object-contain opacity-90 sm:h-16" />
          ) : (
            <Image src={badge.src} alt={badge.alt} class="h-14 w-auto object-contain opacity-90 sm:h-16" height={64} />
          );
        }
        return typeof badge.src === "string" ? (
          <img src={badge.src} alt={badge.alt} class="h-10 w-auto object-contain opacity-90 sm:h-12" />
        ) : (
          <Image src={badge.src} alt={badge.alt} class="h-10 w-auto object-contain opacity-90 sm:h-12" height={48} />
        );
      })}
    </div>
  </div>
</section>
