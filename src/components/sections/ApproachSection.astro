---
import { Image, type ImageMetadata } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  title: string;
  ctaLabel: string;
  ctaHref: string;
}

const { image, imageAlt, eyebrow, title, ctaLabel, ctaHref } = Astro.props;
---

<section class="approach">
  <div class="content approach-inner">
    <div class="approach-image">
      <Image src={image} alt={imageAlt} width={620} height={775} fit="cover" />
    </div>

    <div class="approach-content">
      <SectionHeading eyebrow={eyebrow} title={title} />

      <div class="approach-body">
        <slot />
      </div>

      <Button href={ctaHref} variant="solid">{ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .approach {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-white);
    padding: 64px var(--gutter);
  }

  .approach-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .approach-image {
    height: 360px;
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
    background: #e4e5eb;
  }

  .approach-image :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .approach-content {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
  }

  .approach-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: justify;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.625;
    color: var(--color-ink);
  }

  .approach-body :global(strong),
  .approach-body :global(.approach-body-strong) {
    font-weight: 700;
  }

  .approach-body :global(.approach-body-semibold) {
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .approach-image {
      height: 500px;
    }
  }

  @media (min-width: 1024px) {
    .approach {
      padding-block: 140px;
    }

    .approach-inner {
      flex-direction: row;
    }

    .approach-image {
      height: 775px;
      width: 620px;
      flex-shrink: 0;
    }

    .approach-content {
      width: 497px;
    }
  }
</style>
