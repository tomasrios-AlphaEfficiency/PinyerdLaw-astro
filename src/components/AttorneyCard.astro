---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  photo: ImageMetadata;
  name: string;
  bio: string;
  tag?: string;
  class?: string;
}

const { photo, name, bio, tag, class: className = "" } = Astro.props;
---

<article class:list={["attorney-card", className]}>
  {tag && <p class="attorney-card-tag">{tag}</p>}

  <div class="attorney-card-photo">
    <Image src={photo} alt={name} width={393} height={315} fit="cover" />
    {tag && <div class="attorney-card-photo-tint"></div>}
  </div>

  <div class="attorney-card-body">
    <div class="attorney-card-heading">
      <h3 class="attorney-card-name">{name}</h3>
      <div class="attorney-card-rule"></div>
    </div>
    <p class="attorney-card-bio">{bio}</p>
  </div>
</article>

<style>
  .attorney-card {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: -6px -6px 27.6px 0 rgba(111, 145, 200, 0.15), 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .attorney-card-tag {
    position: absolute;
    top: 12px;
    left: 50%;
    z-index: 10;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 3.36px;
    color: var(--color-white);
  }

  .attorney-card-photo {
    position: relative;
    height: 315px;
    width: 100%;
    flex-shrink: 0;
  }

  .attorney-card-photo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .attorney-card-photo-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6) 2%, transparent 24%);
  }

  .attorney-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    background: var(--color-white);
    padding: 32px;
  }

  .attorney-card-heading {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .attorney-card-name {
    font-family: var(--font-serif);
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--color-navy-light);
  }

  .attorney-card-rule {
    height: 1px;
    width: 65px;
    background: rgba(21, 56, 96, 0.5);
  }

  .attorney-card-bio {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.625;
    letter-spacing: -0.01em;
    color: var(--color-navy-light);
  }
</style>
