---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  title: string;
  backgroundImage: ImageMetadata;
  backgroundAlt?: string;
}

const { title, backgroundImage, backgroundAlt = "" } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-background">
    <Image src={backgroundImage} alt={backgroundAlt} widths={[640, 1024, 1600, 1920]} sizes="100vw" />
    <div class="page-hero-background-tint"></div>
  </div>

  <div class="content page-hero-content">
    <h1 class="page-hero-title">{title}</h1>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 64px 0;
  }

  .page-hero-background {
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(24px);
  }

  .page-hero-background :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .page-hero-background-tint {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(12px);
    background-image: linear-gradient(
        90deg,
        rgb(255, 255, 255) 0%,
        rgb(255, 255, 255) 49.7%,
        rgba(255, 255, 255, 0) 80%
      ),
      linear-gradient(-21deg, rgba(70, 70, 70, 0.3) 5.4%, rgba(70, 70, 70, 0) 19.7%);
  }

  .page-hero-content {
    padding-inline: var(--gutter);
  }

  .page-hero-title {
    font-family: var(--font-serif);
    font-size: 36px;
    line-height: 1.2;
    text-transform: capitalize;
    color: var(--color-navy);
  }

  @media (min-width: 640px) {
    .page-hero-title {
      font-size: 48px;
    }
  }

  @media (min-width: 1024px) {
    .page-hero {
      padding-block: 87px;
    }
  }
</style>
