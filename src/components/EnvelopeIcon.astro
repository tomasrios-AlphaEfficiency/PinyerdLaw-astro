---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["envelope-icon", className]} role="img" aria-label="">
  <img src="/icons/icon-envelope-1.svg" alt="" class="envelope-icon-part envelope-icon-part--1" aria-hidden="true" />
  <img src="/icons/icon-envelope-2.svg" alt="" class="envelope-icon-part envelope-icon-part--2" aria-hidden="true" />
  <img src="/icons/icon-envelope-3.svg" alt="" class="envelope-icon-part envelope-icon-part--3" aria-hidden="true" />
  <img src="/icons/icon-envelope-4.svg" alt="" class="envelope-icon-part envelope-icon-part--4" aria-hidden="true" />
</div>

<style>
  .envelope-icon {
    position: relative;
    width: 32px;
    aspect-ratio: 32 / 24.374;
  }

  .envelope-icon-part {
    position: absolute;
    display: block;
  }

  .envelope-icon-part--1 {
    left: 5.03%;
    top: 0;
    height: 59.94%;
    width: 89.96%;
  }

  .envelope-icon-part--2 {
    left: 66.06%;
    top: 6.6%;
    height: 86.79%;
    width: 33.94%;
  }

  .envelope-icon-part--3 {
    left: 0;
    top: 6.6%;
    height: 86.79%;
    width: 33.94%;
  }

  .envelope-icon-part--4 {
    left: 5.03%;
    top: 55.42%;
    height: 44.56%;
    width: 89.96%;
  }
</style>
