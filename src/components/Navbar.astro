---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  logoSrc: string;
  logoAlt: string;
  links: NavLink[];
  contactLabel: string;
  contactHref: string;
  searchLabel?: string;
}

const { logoSrc, logoAlt, links, contactLabel, contactHref, searchLabel = "Search" } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white px-6 py-2.5">
  <div class="content flex items-center justify-between gap-8">
    <a href="/" class="shrink-0">
      <img src={logoSrc} alt={logoAlt} class="h-[46px] w-auto" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} class="whitespace-nowrap font-sans text-sm text-navy hover:text-maroon">
          {link.label}
        </a>
      ))}

      <div class="flex items-center gap-3">
        <button
          type="button"
          aria-label={searchLabel}
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-navy"
        >
          <img src="/icons/icon-search.svg" alt="" class="h-4 w-4" aria-hidden="true" />
        </button>
        <a
          href={contactHref}
          class="rounded-xl border border-navy px-4 py-3.5 font-sans text-sm text-navy hover:bg-navy hover:text-white"
        >
          {contactLabel}
        </a>
      </div>
    </nav>

    <button type="button" class="lg:hidden" aria-label="Open menu" id="menu-toggle">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>

    <nav id="mobile-menu" class="absolute left-0 top-full hidden w-full flex-col gap-4 border-t border-line bg-white p-6 lg:hidden" aria-label="Mobile">
      {links.map((link) => (
        <a href={link.href} class="font-sans text-sm text-navy">{link.label}</a>
      ))}
      <a href={contactHref} class="rounded-xl border border-navy px-4 py-3 text-center font-sans text-sm text-navy">
        {contactLabel}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    menu?.classList.toggle("flex");
  });
</script>
